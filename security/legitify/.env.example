# Copie este arquivo para ".env" (mesmo diretório) e preencha os valores.
# NUNCA faça commit do arquivo ".env" com valores reais — ele já deve estar no .gitignore.

# PAT do GitHub com escopos: admin:org, read:enterprise, admin:org_hook, read:org, repo, read:repo_hook
GITHUB_TOKEN=

# (Opcional) Organização(ões) GitHub a auditar, separadas por vírgula.
# Deixe em branco para auditar somente repositórios pessoais, ou se quiser que
# o Legitify analise tudo que o token enxergar.
GITHUB_ORG=

# (Opcional) Repositório(s) específicos "org/repo" ou "usuario/repo", separados por vírgula
GITHUB_REPO=

# (Opcional) 1/true para incluir automaticamente todos os repositórios pessoais
# (fora de organizações) do usuário dono do PAT
LEGITIFY_INCLUDE_PERSONAL_REPOS=

# (Opcional) Namespaces a analisar: organization,actions,member,repository,runner_group
LEGITIFY_NAMESPACES=

# (Opcional) Caminho de arquivo com políticas a ignorar (uma por linha)
LEGITIFY_IGNORE_POLICIES_PATH=

# (Opcional) Diretório onde os relatórios serão salvos
LEGITIFY_OUTPUT_DIR=./reports
